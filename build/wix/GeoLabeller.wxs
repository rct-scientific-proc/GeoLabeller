<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer authoring for GeoLabeller.

  cx_Freeze still produces the frozen application (build_exe); this packages
  that output. Its own bdist_msi is not used, because the choices it bakes in
  at build time are the ones the person installing wants to make: whether the
  install is for everyone or just them, where it goes, and which shortcuts
  they get.

  Built by build/build_windows.ps1 -Wix, which passes the version, the folder
  to package and the publisher details in as preprocessor variables:

      wix build -arch x64 -ext WixToolset.UI.wixext ^
        -d Version=1.3.0 -d PayloadDir=..\build\exe.win-amd64-3.12 ^
        -d Manufacturer="RCT Scientific Processing" -d AboutUrl=https://... ^
        -o GeoLabeller-1.3.0-win64.msi GeoLabeller.wxs

  The dialog flow is the package's own (WixUI_GeoLabeller, below), built
  from the UI extension's standard pages:

      Welcome  (or "an existing install was found")
      Licence  (accept to go on)
      Scope    (just me / everyone)
      Folder   (the default, or Change...)
      Shortcuts (two tick-boxes) - Install

  It replaced WixUI_Advanced, which had two faults users noticed. Its
  first page offered a one-click Install that skipped every choice, and it
  only offered the folder page to a per-machine install: a per-user
  install - the default, and the only kind a standard user can make -
  went straight to the features, so there was no way to pick the folder.
  And the package's upgrade notice was sequenced as a second dialog: its
  chain ran the EULA and returned, and Windows Installer then went on to
  the NEXT sequenced dialog - the EULA again. Every upgrade asked twice.

  Now only WelcomeDlg is sequenced (by the extension, as it ships). Every
  other page is reached with NewDialog inside that one chain, which ends
  once, at Install. No page can be shown twice by the sequence.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="GeoLabeller"
      Manufacturer="$(var.Manufacturer)"
      Version="$(var.Version)"
      Language="1033"
      Compressed="yes"
      Scope="perUserOrMachine"
      UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <!--
      This GUID is what lets Windows Installer recognise an existing install as
      the same product and replace it. It is carried over verbatim from the
      cx_Freeze packaging, so a 1.x install made by the old installer upgrades
      cleanly to one made by this. Changing it strands every existing install.
    -->

    <SummaryInformation Description="GeoLabeller - geospatial image labeling" />

    <!--
      Upgrade, or stop. There is deliberately no side-by-side: two installs of
      the same product would share an UpgradeCode, and Windows Installer treats
      that as one product. Downgrades are refused rather than silently
      half-applied.
    -->
    <!--
      AllowSameVersionUpgrades lets a rebuild of the same version replace what
      is installed, which is what testing an installer actually looks like.
      The cost is validation warning ICE61, because it makes the detected
      version range include the version being installed; that is the intent,
      not an oversight.
    -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first if you need to go back to this version." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs entry. -->
    <Icon Id="GeoLabellerIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="GeoLabellerIcon" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.AboutUrl)" />
    <Property Id="ARPHELPLINK" Value="$(var.AboutUrl)" />
    <!-- The app is the only thing worth removing; hide the "repair" option. -->
    <Property Id="ARPNOREPAIR" Value="1" />

    <!--
      Force every file to be copied on install, repair and upgrade ('a'),
      never skipped by version/hash comparison against whatever is on disk.
      A 1.4.0 -> 1.5.1 upgrade in the field ended with 17 files missing -
      python3.dll and the stdlib extensions, all byte-identical between the
      two versions - leaving an app that could not start. The exact trigger
      never reproduced under controlled upgrades (clean, and with the app
      running), but with this set the failure class is closed outright: a
      skipped copy is impossible, and the whole payload is only ~67 MB.
      Validation flags this as ICE40 ("may cause difficulties") - that
      is it noticing the deliberate choice, not an error.
    -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <Feature Id="MainApplication"
             Title="GeoLabeller"
             Description="The application and everything it needs to run."
             Level="1"
             AllowAbsent="no"
             AllowAdvertise="no">
      <ComponentGroupRef Id="ApplicationFiles" />

      <Feature Id="StartMenuShortcutFeature"
               Title="Start Menu shortcut"
               Description="Add GeoLabeller to the Start Menu."
               Level="1"
               AllowAdvertise="no">
        <ComponentRef Id="StartMenuShortcutComponent" />
      </Feature>

      <Feature Id="DesktopShortcutFeature"
               Title="Desktop shortcut"
               Description="Put a GeoLabeller shortcut on the desktop."
               Level="1"
               AllowAdvertise="no">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>
    </Feature>

    <!--
      What the extension's scope and folder pages read. The install
      directory has to be APPLICATIONFOLDER, the folder page edits whatever
      WIXUI_INSTALLDIR names, and InstallScopeDlg shows its radio buttons
      only when both scopes are declared supported.
    -->
    <Property Id="ApplicationFolderName" Value="GeoLabeller" />
    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
    <WixVariable Id="WixUISupportPerUser" Value="1" />
    <WixVariable Id="WixUISupportPerMachine" Value="1" />
    <!-- Default the choice to a per-user install: it needs no elevation, which
         is how the cx_Freeze installer behaved, so nobody who could install
         the old one is suddenly blocked by a UAC prompt. -->
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />

    <!-- The shortcuts page's two tick-boxes, on to begin with. Secure, so a
         per-machine install keeps them across its elevation. From
         Add/Remove Programs > Change they start as the install is: the
         feature state is known once costing has run. -->
    <Property Id="INSTALLSTARTMENUSHORTCUT" Value="1" Secure="yes" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <SetProperty Id="INSTALLSTARTMENUSHORTCUT" Action="ReadStartMenuShortcutState"
                 Value="{}" After="CostFinalize" Sequence="ui"
                 Condition="Installed AND NOT (!StartMenuShortcutFeature = 3)" />
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Action="ReadDesktopShortcutState"
                 Value="{}" After="CostFinalize" Sequence="ui"
                 Condition="Installed AND NOT (!DesktopShortcutFeature = 3)" />

    <!-- Without this the licence page shows the UI extension's placeholder,
         which is Lorem ipsum. build_windows.ps1 generates the RTF from the
         LICENSE file at the repository root so there is only one copy of it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!--
      Read back what the last install wrote (the breadcrumb component in
      ApplicationFiles): its version, so the upgrade notice can name it, and
      its folder, so the folder page defaults to where the user put it last
      time rather than making them find it again on every release.
      Installs made by the old cx_Freeze packaging never wrote either, so
      both are empty for anyone upgrading from 1.3.0 or earlier.
    -->
    <!-- RegistrySearch cannot take HKMU the way RegistryValue can, so both
         hives are searched and whichever answered is used. A per-user install
         wrote to HKCU, a per-machine one to HKLM. -->
    <Property Id="INSTALLEDVERSIONUSER" Secure="yes">
      <RegistrySearch Id="InstalledVersionUserSearch" Root="HKCU"
                      Key="Software\$(var.Manufacturer)\GeoLabeller"
                      Name="Version" Type="raw" />
    </Property>
    <Property Id="INSTALLEDVERSIONMACHINE" Secure="yes">
      <RegistrySearch Id="InstalledVersionMachineSearch" Root="HKLM"
                      Key="Software\$(var.Manufacturer)\GeoLabeller"
                      Name="Version" Type="raw" />
    </Property>
    <Property Id="PREVIOUSFOLDERUSER" Secure="yes">
      <RegistrySearch Id="PreviousFolderUserSearch" Root="HKCU"
                      Key="Software\$(var.Manufacturer)\GeoLabeller"
                      Name="InstallDir" Type="raw" />
    </Property>
    <Property Id="PREVIOUSFOLDERMACHINE" Secure="yes">
      <RegistrySearch Id="PreviousFolderMachineSearch" Root="HKLM"
                      Key="Software\$(var.Manufacturer)\GeoLabeller"
                      Name="InstallDir" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLEDVERSION" Action="SetInstalledVersionFromUser"
                 Value="[INSTALLEDVERSIONUSER]" After="AppSearch"
                 Condition="INSTALLEDVERSIONUSER" />
    <SetProperty Id="INSTALLEDVERSION" Action="SetInstalledVersionFromMachine"
                 Value="[INSTALLEDVERSIONMACHINE]" After="AppSearch"
                 Condition="INSTALLEDVERSIONMACHINE AND NOT INSTALLEDVERSIONUSER" />

    <!--
      The default folder for each scope, and from them the install folder
      when nothing else set it (a silent install, or the command line). The
      same arrangement WixUI_Advanced makes, with two differences: a folder
      remembered from the last install wins over the stock default, and the
      per-machine default is the 64-bit Program Files - WixUI_Advanced used
      [ProgramFilesFolder], which on x64 is "Program Files (x86)".
    -->
    <SetProperty Id="WixPerUserFolder" Action="SetPerUserFolderDefault"
                 Value="[LocalAppDataFolder]Apps\[ApplicationFolderName]"
                 Before="CostFinalize" Sequence="both"
                 Condition="NOT PREVIOUSFOLDERUSER" />
    <SetProperty Id="WixPerUserFolder" Action="SetPerUserFolderRemembered"
                 Value="[PREVIOUSFOLDERUSER]"
                 After="SetPerUserFolderDefault" Sequence="both"
                 Condition="PREVIOUSFOLDERUSER" />
    <SetProperty Id="WixPerMachineFolder" Action="SetPerMachineFolderDefault"
                 Value="[ProgramFiles64Folder][ApplicationFolderName]"
                 After="SetPerUserFolderRemembered" Sequence="both"
                 Condition="NOT PREVIOUSFOLDERMACHINE" />
    <SetProperty Id="WixPerMachineFolder" Action="SetPerMachineFolderRemembered"
                 Value="[PREVIOUSFOLDERMACHINE]"
                 After="SetPerMachineFolderDefault" Sequence="both"
                 Condition="PREVIOUSFOLDERMACHINE" />
    <SetProperty Id="APPLICATIONFOLDER" Action="SetApplicationFolderPerUser"
                 Value="[WixPerUserFolder]"
                 After="SetPerMachineFolderRemembered" Sequence="both"
                 Condition="ACTION=&quot;INSTALL&quot; AND APPLICATIONFOLDER=&quot;&quot; AND (ALLUSERS=&quot;&quot; OR (ALLUSERS=2 AND (NOT Privileged)))" />
    <SetProperty Id="APPLICATIONFOLDER" Action="SetApplicationFolderPerMachine"
                 Value="[WixPerMachineFolder]"
                 After="SetApplicationFolderPerUser" Sequence="both"
                 Condition="ACTION=&quot;INSTALL&quot; AND APPLICATIONFOLDER=&quot;&quot; AND (ALLUSERS=1 OR (ALLUSERS=2 AND Privileged))" />

    <UI Id="WixUI_GeoLabeller">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <TextStyle Id="WixUI_Font_Emphasized" FaceName="Tahoma" Size="8" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <!-- The extension's pages this flow is made of. WelcomeDlg brings its
           own sequence row (NOT Installed OR PATCH): the one entry point. -->
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="InstallScopeDlg" />
      <DialogRef Id="InvalidDirDlg" />
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="WelcomeDlg" />

      <!--
        Say so before replacing an existing install, rather than silently
        swapping it out. Upgrade goes on to the licence; Cancel backs out.
        There is no third option, by design - see the MajorUpgrade note
        above. Reached from WelcomeDlg's Next, never sequenced on its own.
      -->
      <Dialog Id="UpgradeNoticeDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="20"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}An existing installation was found" />

        <Control Id="KnownVersionText" Type="Text" X="15" Y="50" Width="340" Height="90"
                 NoPrefix="yes" Hidden="yes" ShowCondition="INSTALLEDVERSION"
                 Text="GeoLabeller [INSTALLEDVERSION] is already installed on this computer.

Continuing will replace it with version [ProductVersion]. The existing version is removed as part of the upgrade; your projects and label files are not touched." />

        <Control Id="UnknownVersionText" Type="Text" X="15" Y="50" Width="340" Height="90"
                 NoPrefix="yes" Hidden="yes" ShowCondition="NOT INSTALLEDVERSION"
                 Text="An earlier version of GeoLabeller is already installed on this computer.

Continuing will replace it with version [ProductVersion]. The existing version is removed as part of the upgrade; your projects and label files are not touched." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Back" Type="PushButton" X="156" Y="243" Width="56" Height="17"
                 Text="Back">
          <Publish Event="NewDialog" Value="WelcomeDlg" Condition="1" />
        </Control>
        <Control Id="Next" Type="PushButton" X="212" Y="243" Width="80" Height="17"
                 Default="yes" Text="Upgrade">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>


      <!--
        The shortcuts, as two tick-boxes - on to begin with - rather than
        the stock feature tree, whose drop-down menus ("Will be installed
        on local hard drive") asked users to think in Windows Installer's
        terms for a yes-or-no choice. Install adds or removes each shortcut
        feature from what the box says, then ends the chain. From
        Add/Remove Programs > Change the same page appears, with the boxes
        showing what is installed.
      -->
      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="[ProductName] Setup" TrackDiskSpace="yes">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="210" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose the shortcuts to create." />

        <Control Id="StartMenuCheck" Type="CheckBox" X="20" Y="68" Width="330" Height="18"
                 Property="INSTALLSTARTMENUSHORTCUT" CheckBoxValue="1" Text="&amp;Start Menu shortcut" />
        <Control Id="StartMenuText" Type="Text" X="37" Y="87" Width="310" Height="14" NoPrefix="yes"
                 Text="Add GeoLabeller to the Start Menu." />
        <Control Id="DesktopCheck" Type="CheckBox" X="20" Y="112" Width="330" Height="18"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="&amp;Desktop shortcut" />
        <Control Id="DesktopText" Type="Text" X="37" Y="131" Width="310" Height="14" NoPrefix="yes"
                 Text="Put a GeoLabeller shortcut on the desktop." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="156" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Install" Type="PushButton" ElevationShield="yes" X="212" Y="243" Width="80" Height="17"
                 Hidden="yes" ShowCondition="NOT Installed AND ALLUSERS" DefaultCondition="NOT Installed" Text="&amp;Install">
          <Publish Event="AddLocal" Value="StartMenuShortcutFeature" Condition="INSTALLSTARTMENUSHORTCUT" Order="1" />
          <Publish Event="Remove" Value="StartMenuShortcutFeature" Condition="NOT INSTALLSTARTMENUSHORTCUT" Order="2" />
          <Publish Event="AddLocal" Value="DesktopShortcutFeature" Condition="INSTALLDESKTOPSHORTCUT" Order="3" />
          <Publish Event="Remove" Value="DesktopShortcutFeature" Condition="NOT INSTALLDESKTOPSHORTCUT" Order="4" />
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Condition="!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1" Order="5" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace &lt;&gt; 1" Order="6" />
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" Order="7" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="8" />
          <Publish Event="EnableRollback" Value="False" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="9" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" Order="10" />
        </Control>
        <Control Id="InstallNoShield" Type="PushButton" ElevationShield="no" X="212" Y="243" Width="80" Height="17"
                 Hidden="yes" ShowCondition="NOT Installed AND NOT ALLUSERS" DefaultCondition="NOT Installed" Text="&amp;Install">
          <Publish Event="AddLocal" Value="StartMenuShortcutFeature" Condition="INSTALLSTARTMENUSHORTCUT" Order="1" />
          <Publish Event="Remove" Value="StartMenuShortcutFeature" Condition="NOT INSTALLSTARTMENUSHORTCUT" Order="2" />
          <Publish Event="AddLocal" Value="DesktopShortcutFeature" Condition="INSTALLDESKTOPSHORTCUT" Order="3" />
          <Publish Event="Remove" Value="DesktopShortcutFeature" Condition="NOT INSTALLDESKTOPSHORTCUT" Order="4" />
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Condition="!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1" Order="5" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace &lt;&gt; 1" Order="6" />
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" Order="7" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="8" />
          <Publish Event="EnableRollback" Value="False" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="9" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" Order="10" />
        </Control>
        <Control Id="Change" Type="PushButton" ElevationShield="yes" X="212" Y="243" Width="80" Height="17"
                 Hidden="yes" ShowCondition="Installed AND ALLUSERS" DefaultCondition="Installed" Text="&amp;Change">
          <Publish Event="AddLocal" Value="StartMenuShortcutFeature" Condition="INSTALLSTARTMENUSHORTCUT" Order="1" />
          <Publish Event="Remove" Value="StartMenuShortcutFeature" Condition="NOT INSTALLSTARTMENUSHORTCUT" Order="2" />
          <Publish Event="AddLocal" Value="DesktopShortcutFeature" Condition="INSTALLDESKTOPSHORTCUT" Order="3" />
          <Publish Event="Remove" Value="DesktopShortcutFeature" Condition="NOT INSTALLDESKTOPSHORTCUT" Order="4" />
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Condition="!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1" Order="5" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace &lt;&gt; 1" Order="6" />
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" Order="7" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="8" />
          <Publish Event="EnableRollback" Value="False" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="9" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" Order="10" />
        </Control>
        <Control Id="ChangeNoShield" Type="PushButton" ElevationShield="no" X="212" Y="243" Width="80" Height="17"
                 Hidden="yes" ShowCondition="Installed AND NOT ALLUSERS" DefaultCondition="Installed" Text="&amp;Change">
          <Publish Event="AddLocal" Value="StartMenuShortcutFeature" Condition="INSTALLSTARTMENUSHORTCUT" Order="1" />
          <Publish Event="Remove" Value="StartMenuShortcutFeature" Condition="NOT INSTALLSTARTMENUSHORTCUT" Order="2" />
          <Publish Event="AddLocal" Value="DesktopShortcutFeature" Condition="INSTALLDESKTOPSHORTCUT" Order="3" />
          <Publish Event="Remove" Value="DesktopShortcutFeature" Condition="NOT INSTALLDESKTOPSHORTCUT" Order="4" />
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Condition="!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1" Order="5" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace &lt;&gt; 1" Order="6" />
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" Order="7" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="8" />
          <Publish Event="EnableRollback" Value="False" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="9" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" Order="10" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <!-- Welcome: on to the notice when an older install is present, else
           the licence. A patch (never shipped, kept for completeness) goes
           straight to the summary. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="UpgradeNoticeDlg"
               Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg"
               Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg"
               Condition="Installed AND PATCH" />

      <!-- Licence: shown once, on this path only. -->
      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"
               Condition="NOT WIX_UPGRADE_DETECTED" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="UpgradeNoticeDlg"
               Condition="WIX_UPGRADE_DETECTED" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallScopeDlg"
               Condition="LicenseAccepted = &quot;1&quot;" />

      <!-- Scope: just me or everyone. A standard user is not shown the choice
           and gets per-user. Either way the folder page comes next, with the
           scope's default folder in it. -->
      <Publish Dialog="InstallScopeDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="WixAppFolder" Value="WixPerUserFolder"
               Order="1" Condition="NOT Privileged" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="ALLUSERS" Value="{}"
               Order="2" Condition="WixAppFolder = &quot;WixPerUserFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="ALLUSERS" Value="1"
               Order="3" Condition="WixAppFolder = &quot;WixPerMachineFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="APPLICATIONFOLDER" Value="[WixPerUserFolder]"
               Order="4" Condition="WixAppFolder = &quot;WixPerUserFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="APPLICATIONFOLDER" Value="[WixPerMachineFolder]"
               Order="5" Condition="WixAppFolder = &quot;WixPerMachineFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Order="6" Condition="1" />

      <!-- Folder: the default for the scope, or Change... to browse. The
           path is validated before going on. -->
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="InstallScopeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_X64"
               Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg"
               Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg"
               Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_X64"
               Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg"
               Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <!-- Shortcuts, then Install (the buttons are the page's own). Also
           where Change from Add/Remove Programs lands. -->
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg"
               Condition="NOT Installed" />
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg"
               Condition="Installed" />

      <!-- Maintenance: Change (shortcuts) or Remove. Repair is hidden by
           ARPNOREPAIR above. -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="ChangeButton" Event="NewDialog" Value="ShortcutsDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg"
               Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"
               Order="3" Condition="Installed AND PATCH" />
    </UI>
    <UIRef Id="WixUI_Common" />

  </Package>

  <Fragment>
    <!--
      Everything cx_Freeze emitted, harvested at build time. Listing the files
      by hand would mean editing this every time a dependency of PyQt5, GDAL or
      PROJ changes, which is a thing nobody would remember to do.
    -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="GeoLabeller" />
    </StandardDirectory>

    <ComponentGroup Id="ApplicationFiles" Directory="APPLICATIONFOLDER">
      <Files Include="$(var.PayloadDir)\**" />

      <!-- The breadcrumbs the next install reads: the version, for the
           upgrade notice, and the folder, so the folder page defaults to it.
           HKMU follows the install scope, so a per-user install writes them
           under HKCU and a per-machine one under HKLM. -->
      <Component Id="VersionBreadcrumb" Guid="D2E5A146-3B78-4C92-A0F5-7E81B4C6D30A">
        <RegistryValue Root="HKMU"
                       Key="Software\$(var.Manufacturer)\GeoLabeller"
                       Name="Version"
                       Type="string" Value="$(var.Version)" KeyPath="yes" />
        <RegistryValue Root="HKMU"
                       Key="Software\$(var.Manufacturer)\GeoLabeller"
                       Name="InstallDir"
                       Type="string" Value="[APPLICATIONFOLDER]" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!--
      Shortcuts live in their own components so each can be a feature the user
      ticks. HKMU resolves to HKCU or HKLM to match the install scope chosen,
      so the same package works either way.

      Validation raises ICE57 on both of these, and build_windows.ps1
      suppresses it: the rule objects to a component holding per-user data
      (a shortcut under the user's profile) behind a keypath that could be
      either hive. It cannot see that the shortcut folder and HKMU both follow
      ALLUSERS together, so in a package that is deliberately either-scope they
      always agree. Everything else it checks is left switched on.
    -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComponent" Guid="6F3A8B21-7C4D-4E15-9A2B-0D8E5C1F4A73">
        <Shortcut Id="StartMenuShortcut"
                  Name="GeoLabeller"
                  Description="GeoLabeller - geospatial image labeling"
                  Target="[APPLICATIONFOLDER]GeoLabeller.exe"
                  WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue Root="HKMU"
                       Key="Software\$(var.Manufacturer)\GeoLabeller"
                       Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="B49C2E07-51FA-4D63-8C7E-2A6B9F0D3E18">
        <Shortcut Id="DesktopShortcut"
                  Name="GeoLabeller"
                  Description="GeoLabeller - geospatial image labeling"
                  Target="[APPLICATIONFOLDER]GeoLabeller.exe"
                  WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue Root="HKMU"
                       Key="Software\$(var.Manufacturer)\GeoLabeller"
                       Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

</Wix>
